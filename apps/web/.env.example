# ==========================================
# TaskPilot Environment Variables Template
# ==========================================

# Clerk Authentication (Email & Password mode)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Supabase / PostgreSQL Connection Strings (Prisma)
# Example: postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskpilot?schema=public"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/taskpilot?schema=public"

# Resend API (Team Broadcast Emails)
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL="TaskPilot Alerts <notifications@resend.dev>"

# Google ADK / Gemini API Key
GEMINI_API_KEY=placeholder_gemini_key

# Optional: Agent Service Endpoint (Default connects to local ADK microservice)
NEXT_PUBLIC_AGENT_SERVICE_URL=http://localhost:8000
