datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  title     String?  // e.g. "Senior NOC Engineer", "L2 Tech Lead"
  projects  String   // JSON stringified array of assigned project codes ["CMS_VAL_FS", "ASR", "CIAS"]
  role      String   @default("ENGINEER") // ADMIN, TEAM_LEAD, ENGINEER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTasks TaskResolution[] @relation("TaskCreator")

  @@index([email])
}

model TaskResolution {
  id                 Int      @id @default(autoincrement())
  project            String   // "CMS_VAL_FS", "ASR", "CIAS", etc.
  tsp                String   // TSP for CMS VAL&FS or Primary Category for other projects
  lsa                String   // LSA for CMS VAL&FS or Secondary Category for other projects
  status             String   @default("RESOLVED") // RESOLVED, IN_PROGRESS, PENDING_VERIFICATION, CLOSED
  problemDescription String
  solution           String
  remarks            String?
  downtimeMinutes    Int?     @default(0)
  raisedByName       String   @default("NOC Team")
  
  // Optional relations and metadata
  createdById        String?
  createdBy          User?    @relation("TaskCreator", fields: [createdById], references: [id])
  
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
  updatedAt          DateTime @updatedAt

  @@index([project])
  @@index([tsp])
  @@index([lsa])
  @@index([status])
  @@index([resolvedAt])
}

model ProjectDocument {
  id         String   @id @default(uuid())
  project    String   // Project association
  title      String
  category   String   // "SOP", "ARCHITECTURE", "TROUBLESHOOTING_GUIDE", "CHANGELOG"
  content    String
  fileUrl    String?
  version    String   @default("1.0.0")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([project])
  @@index([category])
}
